# ── Nebius AI ────────────────────────────────────────────────────────────────
# Required for running custom (non-preset) queries.
# Presets work without this key — they load from pre-computed cache files.
# Get your key at: https://studio.nebius.com → API Keys
NEBIUS_API_KEY=

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Optional — enables Audit History tab and persistent result storage.
# App works in session-only mode without this.
# Get your URI: cloud.mongodb.com → Connect → Drivers → Python
MONGODB_URI=
